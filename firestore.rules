rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Incidents: strictly scoped to the owner's orgId (user UID)
    match /incidents/{incidentId} {
      allow read: if isSignedIn() && resource.data.orgId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.orgId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.orgId == request.auth.uid && request.resource.data.orgId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.orgId == request.auth.uid;
    }

    // Risk register entries: strictly scoped to the owner's orgId (user UID)
    match /risks/{riskId} {
      allow read: if isSignedIn() && resource.data.orgId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.orgId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.orgId == request.auth.uid && request.resource.data.orgId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.orgId == request.auth.uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}